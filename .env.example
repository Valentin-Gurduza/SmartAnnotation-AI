# ──────────────────────────────────────────────
# SmartAnnotate-AI — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── API Configuration ───────────────────────
# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Default model for pre-labeling (OpenRouter model identifier)
# Options: meta-llama/llama-3.3-70b-instruct, openai/gpt-4o-mini, mistralai/mistral-7b-instruct
DEFAULT_MODEL=minimax/minimax-m3:free
# ─── Confidence Routing ─────────────────────
# Threshold for auto-approval (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.85

# ─── Performance ─────────────────────────────
# Maximum concurrent API requests
MAX_CONCURRENT_REQUESTS=5

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum retries per request
MAX_RETRIES=3

# ─── Application ─────────────────────────────
# Streamlit server port
STREAMLIT_PORT=8501
